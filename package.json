{
  "name": "ztyle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "develop": "gatsby develop -H 0.0.0.0 -p 8000",
    "build": "gatsby build && node scripts/build-offline.cjs",
    "start": "node scripts/serve.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:report": "node -e \"require('fs').mkdirSync('.nen/test-results',{recursive:true});require('fs').mkdirSync('.nen/coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=.nen/test-results/junit.xml --test-reporter=lcov --test-reporter-destination=.nen/coverage/lcov.info tests/*.test.cjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "gatsby": "^5.16.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
